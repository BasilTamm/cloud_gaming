# Copy to .env and fill both passwords before check/up-one/up-two. The build
# and down actions do not read this file. These passwords
# protect the container OS account and its VNC backend; VNC uses only the
# first eight characters. Never put Steam credentials here.

TZ=Etc/UTC
PUID=1000
PGID=1000
RENDER_DEVICE=/dev/dri/renderD128
# SteamOS Podman 5.5.2/Aardvark 1.15.0 failed with the host-derived DNS
# upstream during physical testing. Keep the recursive upstream explicit.
DNS_SERVER=1.1.1.1
DISPLAY_WIDTH=1600
DISPLAY_HEIGHT=900
SHM_SIZE=1g
PIDS_LIMIT=2048

STEAM_1_WEB_PORT=15901
INSTANCE_1_OS_PASSWORD=
STEAM_1_CPUS=3.0
STEAM_1_MEM_LIMIT=5g

STEAM_2_WEB_PORT=15902
INSTANCE_2_OS_PASSWORD=
STEAM_2_CPUS=3.0
STEAM_2_MEM_LIMIT=5g
