# Copy to .env and fill both passwords before running Compose. This file is
# local configuration; never put Steam credentials here.

TZ=Etc/UTC
PUID=1000
PGID=1000
RENDER_DEVICE=/dev/dri/renderD128
SHM_SIZE=1g
PIDS_LIMIT=2048

STEAM_1_WEB_PORT=15901
INSTANCE_1_OS_PASSWORD=
STEAM_1_CPUS=3.0
STEAM_1_MEM_LIMIT=5g

STEAM_2_WEB_PORT=15902
INSTANCE_2_OS_PASSWORD=
STEAM_2_CPUS=3.0
STEAM_2_MEM_LIMIT=5g
