FROM docker.io/josh5/steam-headless@sha256:0d43c66ad0cf54cb0e51208b30f1f297d78264807661a581691224caa4dec0c0

USER root

# Xvfb cannot expose DRI3, so DXVK can create a RADV device but cannot present
# frames. xwfb-run replaces it with Weston headless plus rootful Xwayland. This
# keeps the deployment render-node-only while giving Proton a DRI3 display.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      libgl1-mesa-dri \
      procps \
      util-linux \
      weston \
      x11-utils \
      xauth \
      xwayland \
      xwayland-run \
    && rm -rf /var/lib/apt/lists/* \
    && test -x /usr/bin/weston \
    && test -x /usr/bin/Xwayland \
    && test -x /usr/bin/xwfb-run \
    && test -x /usr/bin/xdpyinfo \
    && test -x /usr/bin/xauth \
    && test -x /usr/bin/setpriv

COPY overlay/usr/local/bin/start-desktop-preserve-groups.sh /usr/local/bin/start-desktop-preserve-groups.sh
COPY overlay/usr/local/bin/start-desktop-unprivileged.sh /usr/local/bin/start-desktop-unprivileged.sh
COPY overlay/usr/local/bin/start-x11vnc-auth.sh /usr/local/bin/start-x11vnc-auth.sh
COPY overlay/usr/local/bin/healthcheck-steam-headless.sh /usr/local/bin/healthcheck-steam-headless.sh
COPY overlay/etc/supervisor.d/desktop.ini /etc/supervisor.d/desktop.ini
COPY overlay/etc/supervisor.d/vnc.ini /etc/supervisor.d/vnc.ini

RUN chmod 0755 \
      /usr/local/bin/start-desktop-preserve-groups.sh \
      /usr/local/bin/start-desktop-unprivileged.sh \
      /usr/local/bin/start-x11vnc-auth.sh \
      /usr/local/bin/healthcheck-steam-headless.sh \
    && test -x /usr/bin/curl
