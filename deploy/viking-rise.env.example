# Copy to deploy/viking-rise.env to override defaults locally. That file is
# gitignored. None of these values are secrets - no Steam credentials are
# ever stored in this project; log into Steam by hand over VNC after start.

# Podman network for this container alone. Keep it unshared: x11vnc runs
# with -nopw on 0.0.0.0:5900 inside the container, so any co-attached
# container reaches VNC directly on the container IP, bypassing the
# loopback publish below.
VIKING_RISE_NETWORK=viking-rise-net

# Container / image names.
VIKING_RISE_CONTAINER=viking-rise-steam
VIKING_RISE_IMAGE=viking-rise-steam:latest

# VNC is published to the host loopback interface only. That bind plus the
# dedicated network above are the entire access control - x11vnc currently
# runs with -nopw. Never expose this beyond 127.0.0.1 without adding real
# VNC authentication first: the Steam password and 2FA code are typed
# through this channel.
VIKING_RISE_VNC_BIND=127.0.0.1
VIKING_RISE_VNC_PORT=15900

# Named volume persisting the Steam install and the logged-in session
# (~/.steam, ~/.local/share/Steam, and the rest of steamuser's home)
# across container restarts.
VIKING_RISE_DATA_VOLUME=viking-rise-steam-data

# Host AMD GPU render node. /dev/dri/renderD128 is expected to be
# world-readable/writable (crw-rw-rw-) on steamdeck; this was not verified
# on the host, so the deploy script checks it at runtime and refuses to
# start otherwise. /dev/dri/card0 is intentionally not used here - it's
# restricted to root/video and isn't needed for render-only access.
VIKING_RISE_RENDER_DEVICE=/dev/dri/renderD128

# Virtual display resolution passed to Xvfb inside the container.
VIKING_RISE_SCREEN=1280x800x24

# Optional x11vnc password file on the host. When it exists, x11vnc runs
# with -rfbauth instead of -nopw. Create it with:
#   x11vnc -storepasswd <password> deploy/viking-rise-vnc.passwd
#   chmod 600 deploy/viking-rise-vnc.passwd
# The file is gitignored, and the deploy script refuses to start unless it
# is mode 600. This is a VNC password only - no Steam credential belongs
# in it, or anywhere else in this project.
VIKING_RISE_VNC_PASSWD_FILE=deploy/viking-rise-vnc.passwd
